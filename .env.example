# 掌灯人 · 环境变量。复制为 .env 后按需填写；全部留空也能启动（用离线演员跑通闭环）。

# 服务端口与数据目录
PORT=8787
# DATA_DIR=./data

# ---- 模型（任选一种；都不填 = 离线演员）----

# 方式一：任意 OpenAI 兼容接口（DeepSeek、通义、Moonshot、OpenRouter、本地 Ollama 的 /v1 等）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=在这里填你的 Key
# LLM_PER_MINUTE=60
# LLM_TIMEOUT_MS=40000
# LLM_EXTRA={"thinking":{"type":"disabled"}}     # 可选：附加到请求体的 JSON

# 方式二：智谱。只填 Key 就会按顺序使用下面三个 Flash 型号，前一个失败自动换下一个
# ZHIPU_API_KEY=在这里填你的 Key
# ZHIPU_MODELS=glm-4.5-flash,glm-4-flash-250414,glm-4.7-flash

# 强制离线（即使上面填了 Key）
# LLM_MODE=offline

# 对公网开放时设为 1：访客自带 Key 时只允许连到白名单里的模型接口主机
# PUBLIC_DEPLOY=0
# 最多保留多少局团（超出后删最旧的）
# MAX_SESSIONS=300
