{
  "id": "tongxing-d100",
  "name": "通行百分骰规则 v1",
  "note": "与市面上常见的百分骰调查恐怖类模组直接兼容的规则包：属性与技能的设置方式、三档难度、奖励骰/惩罚骰、成功等级、孤注一掷、理智检定的「成功损失/失败损失」记法、临时与长期疯狂、按敏捷排先攻，都按这一类跑团的通行设计来。各表沿用通行的栏目结构，数值按通行量级自定，条目文字（疯狂症状、法术与物品效果）均为本项目自写，没有摘录任何规则书的正文。",
  "terms": { "keeper": "守秘人", "pc": "调查员", "hp": "生命值", "mind": "理智", "bonus": "奖励骰", "penalty": "惩罚骰", "push": "孤注一掷", "disorder": "疯狂" },
